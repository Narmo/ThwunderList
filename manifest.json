{
  "manifest_version": 2,
  "name": "ThwunderList",
  "version": "1.2.0",
  "description": "A Mail.app-inspired message list for Thunderbird: contact photos, initials, previews and a calmer card layout.",
  "icons": {
    "16": "icons/thwunderlist.svg",
    "32": "icons/thwunderlist.svg",
    "64": "icons/thwunderlist.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thwunderlist@narmo.dev",
      "strict_min_version": "159.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "mailList": {
      "schema": "experiments/mail-list/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["mailList"]],
        "script": "experiments/mail-list/api.js"
      }
    }
  }
}
